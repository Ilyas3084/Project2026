            { GPIOD, GPIO_PIN_10, GPIO_PIN_RESET, GPIO_PIN_SET   }, /* CH5 Dir2 */

  /* SW3 */ { GPIOD, GPIO_PIN_9,  GPIO_PIN_SET,   GPIO_PIN_RESET }, /* CH6 Dir1 */
            { GPIOD, GPIO_PIN_8,  GPIO_PIN_RESET, GPIO_PIN_SET   }, /* CH7 Dir2 */

  /* SW4 */ { GPIOB, GPIO_PIN_15, GPIO_PIN_SET,   GPIO_PIN_RESET }, /* CH8 Dir1 */
