  /* SW9 */ { GPIOE, GPIO_PIN_11, GPIO_PIN_SET,   GPIO_PIN_RESET }, /* CH18 Dir1 */
            { GPIOE, GPIO_PIN_10, GPIO_PIN_RESET, GPIO_PIN_SET   }, /* CH19 Dir2 */

  /* KEY */ { GPIOE, GPIO_PIN_9,  GPIO_PIN_SET,   GPIO_PIN_RESET }, /* CH20 KEY0 */
            { GPIOE, GPIO_PIN_7,  GPIO_PIN_SET,   GPIO_PIN_RESET }  /* CH21 KEY1 */
};

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USB_DEVICE_Init();

  Clear_All_Outputs();
  HAL_Delay(200);
  Send_Text("STM32 CDC Ready\r\nSend channel 0..21 or ? or status\r\n");

  while (1)
  {
    if (usb_data_ready)
    {
      usb_data_ready = 0;
      Process_USB_Command(usb_rx_buffer, usb_rx_len);
    }

    HAL_Delay(5);
  }
}

static void Process_USB_Command(uint8_t* buf, uint32_t len)
{
  char local[APP_RX_DATA_SIZE];
  char *endptr = NULL;
  long value;

  if (len >= APP_RX_DATA_SIZE)
    len = APP_RX_DATA_SIZE - 1U;

  memcpy(local, buf, len);
  local[len] = '\0';

  while (len > 0U && (local[len - 1U] == '\r' || local[len - 1U] == '\n' || local[len - 1U] == ' '))
  {
    local[len - 1U] = '\0';
    len--;
  }

  if (len == 0U)
    return;

  if (strcmp(local, "?") == 0 || strcmp(local, "status") == 0)
  {
    Send_Status();
    return;
  }

  value = strtol(local, &endptr, 10);
  if (endptr != NULL && *endptr == '\0')
  {
    if (value >= 0 && value < (long)TOTAL_CHANNELS)
    {
      Pulse_Channel((uint8_t)value);

      char resp[32];
      snprintf(resp, sizeof(resp), "OK CH%ld\r\n", value);
      Send_Text(resp);
    }
    else
    {
      Send_Text("ERR: channel must be 0..21\r\n");
    }
    return;
  }

  Send_Text("Send channel 0..21 or ? or status\r\n");
}

static void Clear_All_Outputs(void)
{
  for (uint8_t i = 0; i < TOTAL_CHANNELS; i++)
  {
    HAL_GPIO_WritePin(g_channel_map[i].port, g_channel_map[i].pin, g_channel_map[i].inactive_state);
  }
}

static void Pulse_Channel(uint8_t channel)
{
  if (channel >= TOTAL_CHANNELS)
    return;

  Clear_All_Outputs();
  HAL_GPIO_WritePin(g_channel_map[channel].port, g_channel_map[channel].pin, g_channel_map[channel].active_state);
  HAL_Delay(PULSE_MS);
  HAL_GPIO_WritePin(g_channel_map[channel].port, g_channel_map[channel].pin, g_channel_map[channel].inactive_state);
}

static void Send_Status(void)
{
  char resp[256];
  int offset = snprintf(resp, sizeof(resp), "STATE");

  for (uint8_t i = 0; i < TOTAL_CHANNELS && offset > -1 && offset < (int)sizeof(resp) - 8; i++)
  {
    GPIO_PinState pin_state = HAL_GPIO_ReadPin(g_channel_map[i].port, g_channel_map[i].pin);
    uint8_t logical_state = (pin_state == g_channel_map[i].active_state) ? 1U : 0U;
    offset += snprintf(&resp[offset], sizeof(resp) - (size_t)offset, " %u:%u", i, logical_state);
  }

  snprintf(&resp[strlen(resp)], sizeof(resp) - strlen(resp), "\r\n");
  Send_Text(resp);
}

static void Send_Text(const char *text)
{
  if (text == NULL)
    return;

  uint16_t len = (uint16_t)strlen(text);
  uint32_t timeout = HAL_GetTick() + 100U;

  while (CDC_Transmit_FS((uint8_t*)text, len) == USBD_BUSY)
  {
    if (HAL_GetTick() >= timeout)
      break;
    HAL_Delay(1);
  }
}

